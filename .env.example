# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server-only, used by the cron job

# --- Resend (resend.com > API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Farm Expenses <onboarding@resend.dev>   # replace with your verified domain sender later

# --- Admin who also gets the daily summary ---
ADMIN_EMAIL=admin@example.com

# --- Secret Vercel Cron uses to call the daily-summary route ---
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
